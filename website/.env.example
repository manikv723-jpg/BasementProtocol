# Local development uses private files in ./data. No hosting account is required.
# Vercel production requires a connected private Blob store.
# BLOB_READ_WRITE_TOKEN is injected by Vercel; never expose it to the browser.

# 4ruple license service (server only). In production this is the Supabase edge
# function URL; locally point it at the mock, e.g. http://127.0.0.1:4701/license.
# /api/4ruple/license forwards only the "devices" and "deactivate" actions to it.
FOURUPLE_LICENSE_API=

# Demo checkout only. The mock's "issue" endpoint that stands in for the payment
# webhook, e.g. http://127.0.0.1:4701/issue. Ignored when NODE_ENV=production.
FOURUPLE_DEMO_ISSUE_URL=

# Which checkout the buy buttons open: demo | razorpay | paddle | dodo.
# "razorpay" is implemented. "demo" works only outside production.
# Empty defaults to Razorpay. Missing server credentials show an unavailable dialog,
# never a meeting redirect. Build-time setting.
NEXT_PUBLIC_CHECKOUT_PROVIDER=razorpay

# Licence delivery after a Razorpay payment (/api/4ruple/razorpay-webhook).
# FOURUPLE_ISSUE_URL is the Supabase issue-license function; FOURUPLE_ADMIN_TOKEN is its LICENSE_ADMIN_TOKEN.
# RAZORPAY_WEBHOOK_SECRET is the secret set on the webhook in the Razorpay dashboard.
# Without these three, a captured payment returns 500 so Razorpay keeps retrying and no sale is lost.
FOURUPLE_ISSUE_URL=
FOURUPLE_ADMIN_TOKEN=
RAZORPAY_WEBHOOK_SECRET=
# Optional: smallest rupee payment that counts as a licence sale, in paise. Default 200000.
LICENSE_MIN_PAISE=

# Server-only Razorpay credentials. Use test keys during development.
# The create-order endpoint supplies only the public key ID to Checkout at runtime;
# no NEXT_PUBLIC key or secret is needed.
# Vercel Production requires live keys unless public gateway testing is explicitly enabled.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Temporary, visibly labelled public test checkout only. Set false for real sales.
RAZORPAY_ALLOW_TEST_MODE=false

# Optional LOCAL regional-pricing preview: IN for INR, US (or GB, etc.) for USD.
# Production on Vercel always uses its trusted x-vercel-ip-country header instead.
FOURUPLE_PREVIEW_COUNTRY=IN
